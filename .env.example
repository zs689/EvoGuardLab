# EvoGuardLab 环境变量样例
# 复制为 .env（不要提交）。所有变量都有安全默认值，不配置也能跑 demo。
#
# 两种运行模式（EG-002）：
#   demo        —— 默认。离线零依赖、无鉴权、X-Tenant-Id 仅作本地演示作用域。
#                  **只可绑回环**，绝不直接暴露到网络。
#   enterprise  —— 显式开启。启动期会逐项校验下面的必需配置，缺任一项
#                  **拒绝启动**（fail-closed），而不是带着半吊子安全配置跑起来。

# ---------- 运行模式 ----------
AGENTLAB_MODE=demo

# ---------- 网络 ----------
# 默认只绑 127.0.0.1。容器/内网部署显式设 0.0.0.0，但必须置于 TLS 反代之后。
# AGENTLAB_BIND=127.0.0.1

# ---------- 模型网关 ----------
# mock = 不调用任何模型（默认，确定性、零成本，用于验证机制）
# local = 走本地 OpenAI 兼容端点（Ollama / LM Studio / vLLM 都可以）
AGENTLAB_LLM=mock
# AGENTLAB_LLM_BASE=http://127.0.0.1:11434/v1
# AGENTLAB_LLM_MODEL=qwen3:4b
# AGENTLAB_LLM_TIMEOUT=120

# ---------- 存储路径（EG-011）----------
# 只读资产根目录（前端、配置、taxonomy、metrics.json）
# AGENTLAB_ASSET_ROOT=<repo>
# 可变数据根目录。容器里应指向独立挂载的持久卷。
# AGENTLAB_DATA_ROOT=<repo>/data
# 业务库。按租户分库时，其余租户落在 <DATA_ROOT>/tenants/<tenant>/evoguard.db
# AGENTLAB_DB=<repo>/data/evoguard.db
# 审计库：只有显式设置才落盘（企业模式必需）
# AGENTLAB_AUDIT_DB=<repo>/data/audit.db

# ---------- 服务控制 ----------
# 不设 = 鉴权关闭（仅 demo 可用）。企业模式必须设置。
# 企业模式下它只是「显式开关」，真正的 token 白名单是 IDENTITY_MAP 的键。
# AGENTLAB_API_TOKEN=<随机长 token>
# AGENTLAB_RATE_LIMIT=60
# AGENTLAB_RATE_WINDOW=60
# AGENTLAB_KILL_SWITCH=0
# AGENTLAB_LOG_QUIET=0
# 请求体硬上限（字节），超限返回 413
# AGENTLAB_MAX_BODY_BYTES=65536
# 列表每页最大条数
# AGENTLAB_MAX_PAGE_SIZE=200

# ---------- 企业模式必需（缺失即拒绝启动）----------
# token -> { tenant, actor, roles } 的 JSON 映射。
# roles 取 reader / executor / approver / ops；没有 executor 不能调用写工具。
# 客户端自报的 X-Tenant-Id 与 X-Actor 在企业模式下**一律忽略**。
# AGENTLAB_IDENTITY_MAP={"<token-a>":{"tenant":"acme","actor":"alice","roles":["reader","executor"]},"<token-b>":{"tenant":"beta","actor":"bob","roles":["reader"]}}
# 审批后端标识。没配就**禁用写工具**，不是先执行再补审批。
# AGENTLAB_APPROVAL_BACKEND=review-queue
# AGENTLAB_DB=<挂载卷>/evoguard.db
# AGENTLAB_AUDIT_DB=<挂载卷>/audit.db

# ---------- 安全 ----------
# 恢复期重放写操作是否自动批准。
# 1 = 自动批准并记录（开发默认）；生产环境必须设 0，让人工审批兜住。
AGENTLAB_AUTO_APPROVE=1

# 注意：本项目不需要任何模型 API Key。
# 如果以后接在线模型，在这里写 AGENTLAB_API_KEY=，并确保 .env 已在 .gitignore 里。
